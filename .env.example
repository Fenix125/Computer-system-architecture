#local Kubernetes namespace and facade port-forward target
K8S_NAMESPACE=banking-lab5
FACADE_BASE_URL=http://localhost:9000
FACADE_SERVICE_URL=http://localhost:9000

#demo script timeouts
REQUEST_TIMEOUT_SECONDS=10
SETTLE_TIMEOUT_SECONDS=30
SETTLE_POLL_INTERVAL_SECONDS=0.5

#performance test settings
PERF_CLIENTS=10
PERF_REQUESTS_PER_CLIENT=10000
PERF_REQUEST_TIMEOUT_SECONDS=10
PERF_SETTLE_TIMEOUT_SECONDS=60
PERF_SETTLE_POLL_INTERVAL_SECONDS=0.2
