#host-facing ports exposed from docker compose
FACADE_HOST_PORT=9000
LOGGING_SERVICE_1_HOST_PORT=9001
LOGGING_SERVICE_2_HOST_PORT=9002
LOGGING_SERVICE_3_HOST_PORT=9003
COUNTER_HOST_PORT=9004
CONFIG_SERVER_HOST_PORT=9005
KAFKA_HOST_PORT=9092
POSTGRES_HOST_PORT=5432
HAZELCAST_NODE_1_HOST_PORT=5701
HAZELCAST_NODE_2_HOST_PORT=5702
HAZELCAST_NODE_3_HOST_PORT=5703
HAZELCAST_MC_HOST_PORT=8080

#local service urls derived from the host-facing ports
FACADE_SERVICE_BIND_URL=http://0.0.0.0:${FACADE_HOST_PORT}
FACADE_SERVICE_PUBLIC_URL=http://localhost:${FACADE_HOST_PORT}
FACADE_INSTANCE_NAME=facade-service

LOGGING_SERVICE_BIND_URL=http://0.0.0.0:${LOGGING_SERVICE_1_HOST_PORT}
LOGGING_SERVICE_PUBLIC_URL=http://localhost:${LOGGING_SERVICE_1_HOST_PORT}
LOGGING_INSTANCE_NAME=logging-service-1

COUNTER_SERVICE_BIND_URL=http://0.0.0.0:${COUNTER_HOST_PORT}
COUNTER_SERVICE_PUBLIC_URL=http://localhost:${COUNTER_HOST_PORT}
COUNTER_INSTANCE_NAME=counter-service

CONFIG_SERVER_BIND_URL=http://0.0.0.0:${CONFIG_SERVER_HOST_PORT}
CONFIG_SERVER_PUBLIC_URL=http://localhost:${CONFIG_SERVER_HOST_PORT}
CONFIG_SERVER_INSTANCE_NAME=config-server
CONFIG_SERVER_URL=${CONFIG_SERVER_PUBLIC_URL}

#shared app config used by the python services
KAFKA_BOOTSTRAP_SERVERS=localhost:${KAFKA_HOST_PORT}
KAFKA_COUNTER_TOPIC=counter-transactions

DOWNSTREAM_TIMEOUT_SECONDS=5

POSTGRES_DB=banking
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_DSN=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_HOST_PORT}/${POSTGRES_DB}
POSTGRES_CONNECT_TIMEOUT_SECONDS=10

HAZELCAST_CLUSTER_NAME=bank-hazelcast
HAZELCAST_CLUSTER_MEMBERS=localhost:${HAZELCAST_NODE_1_HOST_PORT},localhost:${HAZELCAST_NODE_2_HOST_PORT},localhost:${HAZELCAST_NODE_3_HOST_PORT}
HAZELCAST_CLUSTER_CONNECT_TIMEOUT_SECONDS=5
HAZELCAST_TRANSACTIONS_MAP_NAME=logging-transactions
HAZELCAST_USER_INDEX_MAP_NAME=logging-user-index
HAZELCAST_SMART_ROUTING=false

LOG_LEVEL=INFO
